# LocAPI JS/TS SDK Example Configuration
# Copy this file to .env and set your credentials:
# cp .env.example .env

# Your LocAPI API Key (create or obtain key at https://locapi.net/console)
LOCAPI_API_KEY=your_api_key_here

# LocAPI Endpoint URL (defaults to https://locapi.dev)
# For local development with Laravel backend, use http://127.0.0.1:8000
LOCAPI_BASE_URL=https://locapi.dev
